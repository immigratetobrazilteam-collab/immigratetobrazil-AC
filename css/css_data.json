{
    "persona": {
        "label": "Remote Explorer",
        "tone": "Adventurous, rugged, natural",
        "visual_intensity": "medium",
        "risk_tolerance": "expressive"
    },
    "tokens": {
        "colors": {
            "primary": "#2f855a",
            "secondary": "#276749",
            "accent": "#48bb78",
            "bg": "#f0fff4",
            "text": "#22543d",
            "hover": "#22543d",
            "active": "#1a3f2e",
            "focus": "#2f855a",
            "success": "#38a169",
            "error": "#e53e3e",
            "warning": "#ecc94b",
            "info": "#4299e1",
            "neutral": "#e2e8f0",
            "link": "#3182ce",
            "border": "#68d391",
            "surface": "#f0fff4",
            "gradient_bg": "linear-gradient(to bottom right, #f0fff4, #d1fae5)"
        },
        "typography": {
            "primary_font": "'Montserrat', system-ui, sans-serif",
            "base_size": "15px",
            "line_height": "1.6",
            "heading_sizes": [
                "2.6rem",
                "2.1rem",
                "1.8rem",
                "1.6rem",
                "1.3rem",
                "1.1rem"
            ]
        },
        "spacing": {
            "xs": "5px",
            "s": "10px",
            "m": "20px",
            "l": "30px",
            "xl": "40px",
            "xxl": "60px"
        },
        "borders": {
            "radius": "8px"
        },
        "shadows": {
            "low": "0 4px 6px rgba(34,84,61,0.1)",
            "medium": "0 10px 20px rgba(34,84,61,0.15)"
        },
        "motion": {
            "timing": "0.6s cubic-bezier(0.16, 1, 0.3, 1)"
        },
        "breakpoints": {
            "tablet": "800px",
            "desktop": "1100px"
        },
        "animations": {
            "duration_base": 0.6,
            "ease_default": "easeInOutQuad",
            "intensity_mod": 1.0,
            "risk_ease": "bounce.out",
            "mobile_mod": 0.7
        }
    },
    "page_customizations": {
        "home": {
            "hero_bg": "var(--color-surface)",
            "cta_color": "var(--color-accent)",
            "section_border": "var(--color-border)"
        },
        "about": {
            "intro_text": "var(--color-text)",
            "section_border": "var(--color-border)",
            "hero_bg": "var(--color-neutral)"
        },
        "services": {
            "overview_bg": "var(--color-surface)",
            "item_accent": "var(--color-accent)",
            "list_color": "var(--color-info)"
        },
        "contact": {
            "form_bg": "var(--color-surface)",
            "submit_btn": "var(--color-primary)",
            "input_border": "var(--color-border)"
        }
    }
}